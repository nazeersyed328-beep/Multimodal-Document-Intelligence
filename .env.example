# Copy this file to .env and replace the placeholder with your own key.
# NEVER commit .env and NEVER place a real API key in this example file.
# Browsing, upload, preprocessing, preview, review, local evaluation, and mocked
# evaluation make no API calls. Gemini calls start only after you prepare a
# document and configure GEMINI_API_KEY. Live evaluation requires explicit opt-in.

# --- Gemini API ---
GEMINI_API_KEY=your-api-key-here
# Configured/default model: gemini-3.8-flash; live response behavior is still pending validation.
GEMINI_MODEL=gemini-3.8-flash
VISION_PROVIDER=gemini

# --- Request behavior ---
# MAX_RETRIES bounds SDK retry attempts and local correction attempts.
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
TEMPERATURE=0
MAX_OUTPUT_TOKENS=8192

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp
MAX_DOCUMENTS_PER_SESSION=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Review policy ---
# Confidence scores are model estimates, not guaranteed probabilities.
# CONFIDENCE_REVIEW_THRESHOLD falls back to CONFIDENCE_THRESHOLD if omitted.
CONFIDENCE_THRESHOLD=0.75
CONFIDENCE_REVIEW_THRESHOLD=0.75

# --- Quality checks ---
# Amounts within this absolute tolerance are treated as arithmetically equal.
AMOUNT_TOLERANCE=0.01
# Dates beyond these horizons are flagged for review, not rejected.
FUTURE_DATE_TOLERANCE_DAYS=365
MAX_PAST_DATE_DAYS=3650
# Maximum number of deterministic findings kept in a quality report.
MAX_QUALITY_ISSUES=200

# --- Evaluation limits ---
# Live evaluation is bounded to one worker by default. Raise only if quota allows.
EVALUATION_MAX_WORKERS=1
# Delay between provider calls during live evaluation, in seconds.
EVALUATION_REQUEST_DELAY_SECONDS=1

# --- PDF rendering limits ---
MAX_PAGES_PER_PDF=50
MAX_PAGES_TO_PROCESS=10
PDF_RENDER_DPI=110
MAX_PDF_RENDER_PIXELS=20000000

# --- Image preprocessing limits ---
MAX_IMAGE_PIXELS=25000000
PREVIEW_MAX_DIMENSION=900
VISION_MAX_DIMENSION=1536
PRESERVE_EXIF_ORIENTATION=true

# --- Paths and timeouts ---
OUTPUT_DIR=outputs
API_TIMEOUT_SECONDS=60
