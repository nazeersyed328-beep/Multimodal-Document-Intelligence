# Environment / secrets
.env
.env.*
!.env.example

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Logs
*.log

# Streamlit secrets
.streamlit/secrets.toml

# Generated artifacts (directories stay tracked through .gitkeep)
outputs/*
!outputs/.gitkeep
reports/*
!reports/.gitkeep
evaluation/results/*
!evaluation/results/.gitkeep
evaluation/reports/*
!evaluation/reports/.gitkeep

# Editors and OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.swp
